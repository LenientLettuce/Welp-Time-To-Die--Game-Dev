<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="ArenaHud.uss" />
  <ui:VisualElement name="arenaRoot" class="arena-root" picking-mode="Ignore">
    <ui:VisualElement class="arena-header">
      <ui:Label name="arenaStatus" class="arena-status" />
      <ui:Button name="resetEncounter" text="Reset" />
    </ui:VisualElement>
    <ui:VisualElement class="arena-footer">
      <ui:VisualElement class="arena-row">
        <ui:Button name="moveMove" text="Move" tooltip="Step for 8 combat frames. Steps up one-block slopes." />
        <ui:Button name="movePunch" text="Punch" tooltip="4-frame startup. Fast interrupt; 9 frames total." />
        <ui:Button name="moveUppercut" text="Uppercut" tooltip="6-frame startup. Launches the target; 15 frames total." />
        <ui:Button name="moveKick" text="Kick" tooltip="7-frame startup. Long reach and knockback; 16 frames total." />
        <ui:Button name="moveDashKick" text="Dash kick" tooltip="8-frame rushing startup; 21 frames total. Terrain and bodies block the rush." />
        <ui:Button name="moveBlock" text="Block" tooltip="Guard your chosen side for 8 frames." />
        <ui:Button name="moveWait" text="Wait" tooltip="Advance 4 combat frames." />
      </ui:VisualElement>
      <ui:VisualElement class="arena-row">
        <ui:Toggle name="showPreview" text="Show preview" value="true" class="preview-toggle"
          tooltip="Loop the selected move. Cyan is you, amber is the enemy, and faint silhouettes mark key poses." />
        <ui:Button name="goAction" class="go-action" text="Go  &gt;" />
      </ui:VisualElement>
      <ui:Label name="arenaHelp" class="arena-help" />
      <ui:Foldout name="mapOptions" text="Map &amp; advanced controls" value="false">
        <ui:ScrollView class="advanced-scroll">
          <ui:Label name="mapDimensions" />
          <ui:Label name="currentSeed" class="seed-label" />
          <ui:TextField name="seedInput" label="Seed" />
          <ui:VisualElement class="arena-row">
            <ui:Button name="generateMap" text="Generate from seed" />
            <ui:Button name="randomizeMap" text="Randomize" />
            <ui:Button name="recenterPlayer" text="Recenter on player" />
          </ui:VisualElement>
          <ui:Label text="Right mouse: browse map · Scroll: zoom · Click world: face left/right" />
          <ui:VisualElement class="arena-row">
            <ui:Button name="moveDash" text="Dash" tooltip="6 frames. Distance scales with strength; terrain blocks movement." />
            <ui:Button name="moveJump" text="Jump" tooltip="12 frames. Grounded only; aim sets horizontal drift." />
            <ui:Button name="aimLeft" text="Face left" />
            <ui:Button name="aimRight" text="Face right" />
          </ui:VisualElement>
          <ui:Slider name="dashPower" label="Dash strength" low-value="0.1" high-value="1" value="1" />
          <ui:VisualElement class="arena-row">
            <ui:Button name="pauseAction" text="Pause / Resume" />
            <ui:Button name="stepFrame" text="Next frame" />
            <ui:Label name="frameCount" />
          </ui:VisualElement>
        </ui:ScrollView>
      </ui:Foldout>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
